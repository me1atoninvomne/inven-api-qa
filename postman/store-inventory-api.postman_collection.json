              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"supplier\": \"QA Supplier\",\n  \"invoiceNumber\": \"QA-INV-{{runId}}\",\n  \"items\": [\n    {\n      \"sku\": \"{{productSku}}\",\n      \"invoicedQuantity\": 10,\n      \"receivedQuantity\": 8\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
