{
  "info": {
    "name": "Store Inventory API — QA",
    "description": "Automated API checks for store-inventory-api. Run in order (folders 01 → 04). Each run uses a unique runId so it can be repeated without restarting the API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"Response time is below 1000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(1000));",
          "if (pm.response.code !== 204) {",
          "  pm.test(\"Response is JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "productSku",
      "value": ""
    },
    {
      "key": "deliveryId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Products — positive",
      "item": [
        {
          "name": "TC-01 List products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// New unique id for every run, so SKUs and invoice numbers never collide",
                  "pm.collectionVariables.set(\"runId\", Date.now().toString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response is an array of products\", () => {",
                  "  const list = pm.response.json();",
                  "  pm.expect(list).to.be.an(\"array\");",
                  "  list.forEach(p => pm.expect(p).to.include.keys(\"id\", \"sku\", \"name\", \"quantity\", \"lowStock\"));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-02 Create product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"qa-{{runId}}\",\n  \"name\": \"QA test product\",\n  \"category\": \"QA-{{runId}}\",\n  \"price\": 1.5,\n  \"quantity\": 20,\n  \"minStock\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 Created\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test(\"Location header points to the new product\", () => {",
                  "  pm.expect(pm.response.headers.get(\"Location\")).to.match(new RegExp(\"/api/products/\" + b.id + \"$\"));",
                  "});",
                  "pm.test(\"SKU is stored in upper case\", () => pm.expect(b.sku).to.eql((\"qa-\" + pm.collectionVariables.get(\"runId\")).toUpperCase()));",
                  "pm.test(\"New product is not low on stock\", () => pm.expect(b.lowStock).to.eql(false));",
                  "pm.collectionVariables.set(\"productId\", b.id);",
                  "pm.collectionVariables.set(\"productSku\", b.sku);"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-03 Get product by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "{{productId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Returns the created product\", () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.id).to.eql(Number(pm.collectionVariables.get(\"productId\")));",
                  "  pm.expect(b.quantity).to.eql(20);",
                  "  pm.expect(b.price).to.eql(1.5);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-04 Update product",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "{{productId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"{{productSku}}\",\n  \"name\": \"QA test product (updated)\",\n  \"category\": \"QA-{{runId}}\",\n  \"price\": 3.49,\n  \"quantity\": 12,\n  \"minStock\": 15\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Fields are updated and product becomes low on stock\", () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.name).to.eql(\"QA test product (updated)\");",
                  "  pm.expect(b.price).to.eql(3.49);",
                  "  pm.expect(b.lowStock).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-05 Low-stock report contains product",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/low-stock",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "low-stock"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Updated product is in the low-stock list\", () => {",
                  "  const skus = pm.response.json().map(p => p.sku);",
                  "  pm.expect(skus).to.include(pm.collectionVariables.get(\"productSku\"));",
                  "});",
                  "pm.test(\"Every listed product is at or below minimum stock\", () => {",
                  "  pm.response.json().forEach(p => pm.expect(p.quantity).to.be.at.most(p.minStock));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-06 Sell items",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}/sell",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "{{productId}}",
                "sell"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Stock decreased from 12 to 10\", () => pm.expect(pm.response.json().quantity).to.eql(10));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-07 Filter by category (case-insensitive)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?category=qa-{{runId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ],
              "query": [
                {
                  "key": "category",
                  "value": "qa-{{runId}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Exactly one product in the test category\", () => pm.expect(pm.response.json()).to.have.lengthOf(1));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
