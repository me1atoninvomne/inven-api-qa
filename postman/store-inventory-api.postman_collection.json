            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"qa-{{runId}}\",\n  \"name\": \"QA test product\",\n  \"category\": \"QA-{{runId}}\",\n  \"price\": 1.5,\n  \"quantity\": 20,\n  \"minStock\": 5\n}",
