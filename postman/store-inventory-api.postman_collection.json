              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Error body has standard shape\", () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b).to.have.all.keys(\"timestamp\", \"status\", \"error\", \"message\", \"details\");",
                  "  pm.expect(b.status).to.eql(pm.response.code);",
                  "});",
                  "pm.test(\"Three field errors: sku, price, quantity\", () => {",
                  "  const d = pm.response.json().details;",
                  "  pm.expect(d).to.have.lengthOf(3);",
                  "  [\"sku\", \"price\", \"quantity\"].forEach(f => pm.expect(d.some(x => x.startsWith(f + \":\"))).to.be.true);",
                  "});"
                ]
              }
            }
          ]
        },
