            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"\",\n  \"name\": \"X\",\n  \"category\": \"Dairy\",\n  \"price\": -1,\n  \"quantity\": -5,\n  \"minStock\": 0\n}",
              "options": {
