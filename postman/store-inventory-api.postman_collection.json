                  "pm.test(\"Delivery is marked as DISCREPANCY\", () => {",
                  "  pm.expect(b.status).to.eql(\"DISCREPANCY\");",
                  "  pm.expect(b.discrepancyCount).to.eql(1);",
                  "  pm.expect(b.items[0].difference).to.eql(-2);",
                  "});",
                  "pm.collectionVariables.set(\"deliveryId\", b.id);"
